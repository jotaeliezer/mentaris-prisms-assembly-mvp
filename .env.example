# Public Supabase settings for live sessions.
# Copy this file to .env and fill in your project. Never commit .env.
# Use the project URL and the anon / publishable key only.
# Saves also use this key. Turn on anonymous sign-ins in Authentication
# so a pilot can keep up to five assemblies.
# Do not put the service_role or secret key here. That key must stay on the server.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
